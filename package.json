{
  "name": "nestgres",
  "version": "1.0.0",
  "private": true,
  "description": "A small NestJS, Postgres and Angular admin panel built for hands-on backend practice.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run start --workspace=apps/web"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
